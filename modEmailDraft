Private Function GetEmailLocalFolder(ByRef appConfig As TAppConfig, ByVal dtRunTimestamp As Date) As String
    Const METHOD_NAME As String = "GetEmailLocalFolder"
    Dim errDescription As String
    Dim errNumber As Long
    Dim strLocalRoot As String
    Dim strResult As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    If appConfig.SaveLocal Then
        strLocalRoot = ResolveConfiguredPath(appConfig.OutputLocalBase)
        strResult = BuildDatedFolderPath(strLocalRoot, DateValue(dtRunTimestamp))
    Else
        strResult = "not enabled"
    End If

ExitPoint:
    If errNumber = 0 Then GetEmailLocalFolder = strResult
    If errNumber <> 0 Then Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    Exit Function

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError(CLASS_NAME, METHOD_NAME, errNumber, errDescription, "saveLocal;outputLocalBase", appConfig.SaveLocal, appConfig.OutputLocalBase)
    GoTo ExitPoint
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-27
' Parameters:    appConfig As TAppConfig
' Returns:       String
' Description:   Returns the browser SharePoint URL to include in the email body.
'-------------------------------------------------------------------------------
Private Function GetEmailSharePointUrl(ByRef appConfig As TAppConfig) As String
    Const METHOD_NAME As String = "GetEmailSharePointUrl"
    Dim errDescription As String
    Dim errNumber As Long
    Dim strResult As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    strResult = Trim$(appConfig.MailSharePointUrl)

    If Len(strResult) = 0 Then
        If appConfig.SaveSharePoint Then
            If IsHttpPath(appConfig.OutputSharePointBase) Then strResult = Trim$(appConfig.OutputSharePointBase)
        End If
    End If

ExitPoint:
    If errNumber = 0 Then GetEmailSharePointUrl = strResult
    If errNumber <> 0 Then Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    Exit Function

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError(CLASS_NAME, METHOD_NAME, errNumber, errDescription, "mailSharePointUrl;outputSharePointBase", appConfig.MailSharePointUrl, appConfig.OutputSharePointBase)
    GoTo ExitPoint
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-27
' Parameters:    strValue As String
' Returns:       String
' Description:   HTML-encodes text before insertion into Outlook HTMLBody.
'-------------------------------------------------------------------------------
Private Function HtmlEncode(ByVal strValue As String) As String
    Const METHOD_NAME As String = "HtmlEncode"
    Dim errDescription As String
    Dim errNumber As Long
    Dim strResult As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    strResult = strValue
    strResult = Replace$(strResult, "&", "&amp;")
    strResult = Replace$(strResult, "<", "&lt;")
    strResult = Replace$(strResult, ">", "&gt;")
    strResult = Replace$(strResult, Chr$(34), "&quot;")
    strResult = Replace$(strResult, "'", "&#39;")

ExitPoint:
    If errNumber = 0 Then HtmlEncode = strResult
    If errNumber <> 0 Then Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    Exit Function

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-27
' Parameters:    objMail As Object
' Returns:       Boolean
' Description:   Applies the Internal MIP label on a best-effort basis without blocking draft creation.
'-------------------------------------------------------------------------------
Private Function TryApplyInternalLabel(ByVal objMail As Object) As Boolean
    Const METHOD_NAME As String = "TryApplyInternalLabel"
    Dim blnResult As Boolean
    Dim errDescription As String
    Dim errNumber As Long

    If Not DEV_MODE Then On Error GoTo ErrHandler

    If Not APPLY_INTERNAL_LABEL Then
        blnResult = True
        GoTo ExitPoint
    End If

    objMail.PropertyAccessor.SetProperty MSIP_LABEL_SCHEMA, INTERNAL_LABEL_METADATA
    blnResult = True

ExitPoint:
    TryApplyInternalLabel = blnResult
    Exit Function

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    blnResult = False
    GoTo ExitPoint
End Function
